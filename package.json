{
  "name": "proofmarks-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @proofmarks/playground dev",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:consumer": "node scripts/test-consumers.mjs",
    "audit:bundle": "node scripts/bundle-audit.mjs",
    "audit:package": "node scripts/release-package-audit.mjs",
    "audit:links": "node scripts/check-external-links.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:agent-docs": "node scripts/agent-docs-audit.mjs",
    "benchmark:release": "node scripts/performance-baseline.mjs",
    "test:all": "pnpm test && pnpm test:consumer && pnpm test:browser",
    "typecheck": "pnpm -r typecheck",
    "verify:release": "pnpm build && pnpm typecheck && pnpm test && pnpm audit:security && pnpm audit:agent-docs && pnpm audit:package && pnpm audit:bundle && pnpm test:consumer && pnpm test:browser && pnpm test:pages && git diff --check",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "pnpm build:pages && playwright test --config playwright.pages.config.ts",
    "demo:zhenhua": "pnpm --filter @proofmarks/demo-zhenhua dev",
    "demo:diff-ink": "pnpm --filter @proofmarks/demo-diff-ink dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
